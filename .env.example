DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# クラウドワークス
CROWDWORKS_EMAIL=
CROWDWORKS_PASSWORD=

# ランサーズ
LANCERS_EMAIL=
LANCERS_PASSWORD=

# ココナラ
COCONALA_EMAIL=
COCONALA_PASSWORD=

# 案件の最低単価（円）
MIN_PRICE_ARTICLE=3000
MIN_PRICE_LP=15000
MIN_PRICE_TRANSLATION=5000
MIN_PRICE_DEFAULT=3000

# ダッシュボード
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# スクレイパ並列数 (Render Free 512MB は 1 推奨。Standard 以上なら 2〜4)
SCRAPER_WORKERS=1

# DB 永続化したい場合は外部 Postgres を指定 (Supabase / Neon 等)
# 例: postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///./aidairiten.db
