{
  "name": "aidairiten",
  "image": "mcr.microsoft.com/playwright/python:v1.48.0-jammy",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && playwright install chromium",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Dashboard (FastAPI)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.terminal.activateEnvironment": false
      }
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "DASHBOARD_HOST": "0.0.0.0",
    "DASHBOARD_PORT": "8000"
  }
}
